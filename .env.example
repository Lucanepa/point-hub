# LedBox bridge configuration — copy to `.env` (or use as systemd EnvironmentFile).

# OpenVolley LAN relay (the eScoresheet server) WebSocket endpoint. Default port 8080.
RELAY_URL=ws://127.0.0.1:8080

# Which match to mirror onto the LedBox — the numeric match id shown in the app. Required.
MATCH_ID=

# Physical Tech4Sport LedBox. Default is its own Wi-Fi hotspot address.
LEDBOX_HOST=172.24.1.1
LEDBOX_PORT=8889
LEDBOX_LAYOUT=volleyball_matchscore_02

# Testing: MOCK=1 runs an in-process mock LedBox instead of real hardware.
MOCK=
# DEBUG=1 logs every live-state update.
DEBUG=

# Where the tablet app's release lives (pointhub.apk + version.json from android/build-release.sh),
# served at /app/pointhub.apk and /app/version.json, with an install page at /app.
# Default: <install dir>/android/dist (deploy-board.sh copies it there).
# APP_DIST_DIR=
