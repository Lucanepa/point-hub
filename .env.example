# LedBox bridge configuration — copy to `.env` (or use as systemd EnvironmentFile).

# OpenVolley relay (the scorer laptop) WebSocket endpoint. On the appliance this is only a fallback:
# the console's Settings ▸ Scorer laptop address wins, and with neither set the board looks for the
# laptop on its own Wi-Fi and cable (RELAY_DISCOVERY=own|all|0). Default ws://127.0.0.1:8080.
# RELAY_URL=ws://172.24.1.23:8080
# Only to pin the match-list URL; by default it is the relay's own origin, then port 5173.
# RELAY_HTTP_URL=
# RELAY_DISCOVERY=own

# Headless bridge (src/bridge.js) only: which match to mirror — its SEED KEY (match_…, the `id` in
# the relay's /api/match/list or the scorer's QR code), not the app's numeric match id.
MATCH_ID=

# Physical Tech4Sport LedBox. Default is its own Wi-Fi hotspot address.
LEDBOX_HOST=172.24.1.1
LEDBOX_PORT=8889
LEDBOX_LAYOUT=volleyball_matchscore_02

# Testing: MOCK=1 runs an in-process mock LedBox instead of real hardware.
MOCK=
# DEBUG=1 logs every live-state update.
DEBUG=

# Where the tablet app's release lives (pointhub.apk + version.json from android/build-release.sh),
# served at /app/pointhub.apk and /app/version.json, with an install page at /app.
# Default: <install dir>/android/dist (deploy-board.sh copies it there).
# APP_DIST_DIR=
