<?xml version='1.0'?>
<layout name="volleyball_matchscore_timeout_02" modifier="">
  <!-- The countdown screen for openscore, under the name the vendor app and the bridge ask for
       (src/volleyballMapper.js toCountdownSections; the bridge falls back to it when kscw_break is
       missing). Our own layout: the clock big in the middle, the label above it, the two scores
       in small boxes either side and the set score underneath.

       What the bridge fills, per break: a timeout puts the points in the boxes and the set score
       on the bottom line; a set interval puts the set score in the boxes and blanks the line; a
       warm-up shows the clock alone and leaves the boxes unpainted, which is why their border
       starts black. `media` is kept (empty) because the bridge blanks it on every countdown. -->
  <section name="media" type="image" x="0" y="0" width="192" height="64" visible="true" private="false" enable="true" src="" align="center" valign="middle"></section>
  <section name="lbl" type="text" x="96" y="7" width="100" visible="true" private="false" enable="true" fontsize="12" color="200, 200, 200" align="center" valign="middle">TIMEOUT</section>
  <section name="timer" type="text" x="96" y="35" width="104" visible="true" private="false" enable="true" fontsize="34" color="255, 255, 255" align="center" valign="middle">0:30</section>
  <section name="bg_score1" type="rectangle" x="0" y="17" width="41" height="32" visible="true" private="false" enable="true" color="0, 0, 0" bordercolor="0, 0, 0"></section>
  <section name="score1" type="text" x="21" y="33" width="38" visible="true" private="false" enable="true" fontsize="22" color="37, 99, 235" align="center" valign="middle"></section>
  <section name="bg_score2" type="rectangle" x="150" y="17" width="41" height="32" visible="true" private="false" enable="true" color="0, 0, 0" bordercolor="0, 0, 0"></section>
  <section name="score2" type="text" x="171" y="33" width="38" visible="true" private="false" enable="true" fontsize="22" color="239, 68, 68" align="center" valign="middle"></section>
  <section name="set1" type="text" x="91" y="57" visible="true" private="false" enable="true" fontsize="14" color="255, 255, 255" align="right" valign="middle"></section>
  <section name="sep" type="text" x="96" y="57" visible="true" private="false" enable="true" fontsize="14" color="255, 255, 255" align="center" valign="middle"></section>
  <section name="set2" type="text" x="101" y="57" visible="true" private="false" enable="true" fontsize="14" color="255, 255, 255" align="left" valign="middle"></section>
</layout>
