<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/setup_intro"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/setupSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_ssid"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/setupPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_pass"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <CheckBox
            android:id="@+id/setupShowPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_show_pass"
            android:textColor="@color/text" />

        <LinearLayout
            android:id="@+id/setupPinGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/setupPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_pin"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:minHeight="48dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/setupPin2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_pin2"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:minHeight="48dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/setupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/danger"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setupSave"
                style="@style/PH.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_save" />

            <Button
                android:id="@+id/setupSkip"
                style="@style/PH.Button.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/setup_skip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
