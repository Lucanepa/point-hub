[Unit]
Description=OpenVolley LedBox appliance (control UI + virtual board, mirrors live score to a Tech4Sport LedBox)
# network.target, NOT network-online.target. The appliance listens on 0.0.0.0, reaches the panel over
# loopback, and every network path it has (live push, schedule, relay search, clock sync) retries on
# its own — so waiting for "online" bought nothing but NetworkManager-wait-online (up to 60 s, every
# autoconnect profile in range tried first) in front of the console a volunteer is waiting for. On
# an installed board, provisioning/bridge-boot-order.sh measures that and makes the same change.
After=network.target

[Service]
Type=simple
# Adjust the user and paths to match your install location.
User=pi
WorkingDirectory=/home/pi/ledbox-bridge
# Optional overrides (RELAY_URL, MATCH_ID, LEDBOX_HOST, MOCK, ...). The leading '-'
# makes a missing file non-fatal, so the appliance still boots on config defaults.
EnvironmentFile=-/home/pi/ledbox-bridge/.env
# Drives the real Tech4Sport LedBox at LEDBOX_HOST (see .env — cabled installs use
# 192.168.5.1, box-as-AP installs 172.24.1.1). For a hardware-free bench test, set
# MOCK=1 in .env rather than here, so the venue unit always means "real board".
# Not /usr/bin/node. The Tech4Sport board ships an ancient distro Node, so the runtime is a
# tarball install under /opt/nodejs — a SYMLINK to a versioned directory
# (/opt/nodejs -> /opt/nodejs-22.23.2), which makes an upgrade or a rollback one atomic flip
# with the previous version still on disk. /usr/local/bin/node points at the same place, so the
# shell and this unit can never disagree about which runtime is in use.
ExecStart=/opt/nodejs/bin/node src/appliance.js
Restart=always
RestartSec=5
# A clean stop takes milliseconds, and the appliance bounds its own shutdown at 5s. The default
# 90s is what a stuck stop used to cost: a sport switch, a deploy or a poweroff frozen for a minute
# and a half with a stale panel, long enough for a volunteer to pull the plug on the SD card.
# 15s leaves the appliance room to exit on its own and caps the damage if it somehow cannot.
TimeoutStopSec=15
# The default KillMode=control-group stays, on purpose: stopping this unit takes down everything
# it started. The LED panel driver is the one thing that must outlive a restart, so the appliance
# launches it as its own transient unit (systemd-run, see PANEL_RESTART in src/controlServer.js)
# rather than as a child — it is never in this cgroup to begin with.

[Install]
WantedBy=multi-user.target
