[Unit]
Description=Point Hub board touchscreen (console or OpenVolley, see Settings > Board screen)
After=ledbox-bridge.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
SupplementaryGroups=video render input
EnvironmentFile=-/etc/default/pointhub-screen
ExecStart=/opt/pointhub/pointhub-screen
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
